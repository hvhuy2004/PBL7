DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/agile_ai_management
APP_ENV=development
SECRET_KEY=change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Prompt-to-Task AI providers. Backend tries GitHub Models first when configured.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_TASK_MODEL=openai/gpt-4o
GITHUB_MODELS_TASK_TIMEOUTS=8
GITHUB_MODELS_DAILY_LIMIT=50
OPENROUTER_API_KEY=
OPENROUTER_TASK_MODEL=openai/gpt-oss-20b:free
OPENROUTER_TASK_TIMEOUTS=8
AI_REQUEST_TIMEOUT_SECONDS=10
AI_MAX_TOKENS=300
AI_USER_DAILY_LIMIT=30
AI_ADMIN_DAILY_LIMIT=80
AI_USER_COOLDOWN_SECONDS=8
AI_DUPLICATE_DAILY_LIMIT=120
AI_DUPLICATE_COOLDOWN_SECONDS=0
GEMINI_API_KEY=
GEMINI_TASK_MODEL=gemini-2.5-flash-lite
GEMINI_TASK_TIMEOUT_SECONDS=8
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_TASK_MODEL=gpt-4o-mini
OPENAI_TASK_TIMEOUT_SECONDS=8
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AgileAI Prompt-to-Task
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
TASK_DUPLICATE_THRESHOLD=0.90

# Optional embedding model if using official OpenAI for duplicate detection.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Production safety. Set both schema flags to false after applying migrations.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_CREATE_SCHEMA=true
AUTO_SYNC_SCHEMA=true
